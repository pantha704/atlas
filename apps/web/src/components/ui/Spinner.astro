---
interface Props {
  size?: 'sm' | 'md' | 'lg'
  class?: string
  label?: string
}

const { size = 'md', class: className = '', label = 'Loading' } = Astro.props

const sizes: Record<string, string> = {
  sm: 'h-4 w-4 border-2',
  md: 'h-5 w-5 border-2',
  lg: 'h-8 w-8 border-[3px]',
}
---

<span
  class:list={[
    'inline-block animate-spin rounded-full border-border border-t-primary',
    sizes[size],
    className,
  ]}
  role="status"
  aria-label={label}
></span>
