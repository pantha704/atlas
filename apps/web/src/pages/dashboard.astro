---
import { renderDigestMarkdown } from '@atlas/core'
import Badge from '../components/ui/Badge.astro'
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import AppShell from '../layouts/AppShell.astro'
import { getApiBase } from '../lib/api'

// Absolute base required for SSR (relative /api fails on Vercel Node fetch)
const API_URL = getApiBase(Astro.url)
// Browser scripts can keep same-origin relative path
const CLIENT_API = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
const cookie = Astro.request.headers.get('cookie') ?? ''

type DigestMode = 'personal' | 'public' | 'demo' | 'empty'

let digestMd: string | null = null
let digestError: string | null = null
let mode: DigestMode = 'empty'
let itemMeta: { scored?: number; fromCache?: number; newlyScored?: number } | null = null
let userName: string | null = null
let userPlan: string | null = null

async function fetchJson<T>(
  path: string,
  init?: RequestInit & { timeoutMs?: number },
): Promise<{ ok: boolean; status: number; data: T | null }> {
  const timeoutMs = init?.timeoutMs ?? 8000
  try {
    const res = await fetch(`${API_URL}${path}`, {
      ...init,
      signal: AbortSignal.timeout(timeoutMs),
    })
    const data = (await res.json().catch(() => null)) as T | null
    return { ok: res.ok, status: res.status, data }
  } catch {
    return { ok: false, status: 0, data: null }
  }
}

// 1) Prefer authenticated personal digest (SSR with session cookie)
{
  const me = await fetchJson<{ user?: { name?: string; plan?: string } | null }>('/auth/me', {
    headers: cookie ? { cookie } : {},
    timeoutMs: 6000,
  })
  if (me.ok && me.data?.user) {
    userName = me.data.user.name ?? null
    userPlan = me.data.user.plan ?? 'free'
    const dig = await fetchJson<{
      markdown?: string
      itemCounts?: { scored?: number; fromCache?: number; newlyScored?: number; cached?: boolean }
    }>('/my-digest?peek=1', {
      headers: cookie ? { cookie } : {},
      timeoutMs: 8000,
    })
    if (dig.ok && dig.data?.markdown) {
      digestMd = dig.data.markdown
      mode = 'personal'
      itemMeta = dig.data.itemCounts ?? null
    }
  }
}

// 2) Public global digest (DB-backed)
if (!digestMd) {
  const pub = await fetchJson<{ markdown?: string }>('/digest', { timeoutMs: 8000 })
  if (pub.ok && pub.data?.markdown) {
    digestMd = pub.data.markdown
    mode = 'public'
  } else if (pub.status === 0) {
    digestError = 'Could not reach the API from the server. Retry in a moment.'
  }
}

// 3) Demo seed — never show empty if demo works
if (!digestMd) {
  const demo = await fetchJson<{ markdown?: string }>('/demo/digest', { timeoutMs: 8000 })
  if (demo.ok && demo.data?.markdown) {
    digestMd = demo.data.markdown
    mode = 'demo'
    digestError = null
  }
}

if (!digestMd && !digestError) {
  digestError = userName
    ? 'No personal digest yet. Click “Generate my digest” (needs sources + AI keys).'
    : 'No digest yet. Sign in, add sources, or wait for the daily cron.'
}

const modeLabel =
  mode === 'personal' ? 'Personalized' : mode === 'public' ? 'Global' : mode === 'demo' ? 'Demo' : 'Empty'

const subtitle =
  mode === 'personal'
    ? userName
      ? `Scored for ${userName}. Impact on your stack, not a crowd feed.`
      : 'Scored against your profile and stack.'
    : mode === 'demo'
      ? 'Preview content — generate your personal digest when ready.'
      : mode === 'public'
        ? userName
          ? 'Global digest. Click Generate my digest for personal scores.'
          : 'Shared global digest. Sign in for per-user scoring and impact.'
        : 'Nothing to show yet.'
---

<AppShell title="Digest — Atlas" description="Your daily personal news digest">
  <PageHeader title="Today's digest" description={subtitle}>
    <Fragment slot="actions">
      {
        mode !== 'empty' && (
          <Badge variant={mode === 'personal' ? 'success' : mode === 'demo' ? 'warning' : 'muted'}>
            {modeLabel}
          </Badge>
        )
      }
      {
        userPlan && (
          <Badge variant={userPlan === 'pro' ? 'pro' : 'default'}>
            {userPlan === 'pro' ? 'Pro' : 'Free'}
          </Badge>
        )
      }
    </Fragment>
  </PageHeader>

  <!-- Context banner -->
  {
    mode === 'demo' && (
      <div class="atlas-banner mt-6" data-tone="warn" role="status">
        <span aria-hidden="true">✦</span>
        <div>
          <p class="font-medium text-text">Demo mode</p>
          <p class="mt-0.5">
            This is seed data so the product never feels empty.
            <a href="/signup" class="text-primary">Sign in with GitHub</a>
            {' '}to personalize.
          </p>
        </div>
      </div>
    )
  }
  {
    mode === 'public' && !userName && (
      <div class="atlas-banner mt-6" data-tone="info" role="status">
        <span aria-hidden="true">→</span>
        <div>
          <p class="font-medium text-text">Not signed in</p>
          <p class="mt-0.5">
            You’re viewing the global digest.
            <a href="/signup" class="text-primary">Sign in</a>
            {' '}for scores against your stack.
          </p>
        </div>
      </div>
    )
  }

  <!-- Toolbar -->
  <Card class="mt-6" padding="sm">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-2">
        <Button id="myDigestBtn" variant="primary" size="sm" class="hidden">
          Generate my digest
        </Button>
        <Button id="fetchMoreBtn" variant="secondary" size="sm" class="hidden">
          Fetch more items
        </Button>
        <Button id="forceDigestBtn" variant="secondary" size="sm" class="hidden">
          Force rescore
        </Button>
        <Button id="triggerBtn" variant="ghost" size="sm">
          Run global pipeline
        </Button>
      </div>
      <p id="triggerStatus" class="text-xs text-text-muted sm:text-right" aria-live="polite"></p>
    </div>
    {
      itemMeta && mode === 'personal' && (
        <p class="mt-3 border-t border-border pt-3 text-xs text-text-muted">
          {itemMeta.scored ?? 0} items
          {typeof itemMeta.fromCache === 'number' && (
            <> · {itemMeta.fromCache} cached scores</>
          )}
          {typeof itemMeta.newlyScored === 'number' && itemMeta.newlyScored > 0 && (
            <> · {itemMeta.newlyScored} newly scored</>
          )}
        </p>
      )
    }
  </Card>

  <!-- Digest body -->
  <section id="digest-section" class="mt-8" aria-labelledby="digest-heading" data-mode={mode}>
    <h2 id="digest-heading" class="sr-only">Digest content</h2>
    <div id="digest-empty" class={digestMd ? 'hidden' : ''}>
      {
        digestError && !digestMd && (
          <EmptyState title="No digest yet" description={digestError}>
            <Fragment slot="actions">
              <Button href="/sources" variant="secondary" size="sm">Add sources</Button>
              {
                userName ? (
                  <Button href="/onboarding" variant="primary" size="sm">Finish setup</Button>
                ) : (
                  <Button href="/signup" variant="primary" size="sm">Sign in</Button>
                )
              }
            </Fragment>
          </EmptyState>
        )
      }
    </div>
    <div id="digest-card" class:list={['atlas-card overflow-hidden p-6 sm:p-8', !digestMd && 'hidden']}>
      <article
        id="digest-article"
        class="prose-atlas max-w-none"
        tabindex="0"
        set:html={digestMd ? renderDigestMarkdown(digestMd) : ''}
      />
    </div>
  </section>

  <!-- Quick links -->
  <div class="mt-10 grid gap-3 sm:grid-cols-3">
    <a
      href="/sources"
      class="atlas-card block p-4 no-underline transition-colors hover:border-primary/40"
    >
      <p class="text-sm font-medium text-text">Sources</p>
      <p class="mt-1 text-xs text-text-muted">Connect HN, RSS, GitHub, more</p>
    </a>
    <a
      href="/profile"
      class="atlas-card block p-4 no-underline transition-colors hover:border-primary/40"
    >
      <p class="text-sm font-medium text-text">Profile</p>
      <p class="mt-1 text-xs text-text-muted">Stack, interests, delivery, plan</p>
    </a>
    <a
      href="/market"
      class="atlas-card block p-4 no-underline transition-colors hover:border-primary/40"
    >
      <p class="text-sm font-medium text-text">Market</p>
      <p class="mt-1 text-xs text-text-muted">Browse community sources</p>
    </a>
  </div>

  <script is:inline define:vars={{ apiUrl: CLIENT_API, initialMode: mode }}>
    function setStatus(text) {
      const el = document.getElementById('triggerStatus')
      if (el) el.textContent = text || ''
    }

    function scoreTier(score) {
      if (score >= 9) return 'high'
      if (score >= 7) return 'good'
      if (score >= 5) return 'mid'
      return 'low'
    }

    /**
     * Port of @atlas/core renderDigestMarkdown — correct TOC, score badges, anchors.
     * Prefer API `html` when present (same renderer server-side).
     */
    function renderDigestMarkdown(md) {
      let html = String(md ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
      html = html
        .replace(
          /&lt;details&gt;&lt;summary&gt;([\s\S]*?)&lt;\/summary&gt;/g,
          '<details><summary>$1</summary>',
        )
        .replace(/&lt;ul&gt;/g, '<ul>')
        .replace(/&lt;\/ul&gt;/g, '</ul>')
        .replace(/&lt;li&gt;/g, '<li>')
        .replace(/&lt;\/li&gt;/g, '</li>')
        .replace(/&lt;\/details&gt;/g, '</details>')
        .replace(/&lt;a id="item-(\d+)"&gt;&lt;\/a&gt;/g, '<a id="item-$1"></a>')
      html = html.replace(
        /^## \[([^\]]+)\]\(([^)]+)\) ⭐️ (\d+(?:\.\d+)?)\/10/gm,
        (_m, title, url, score) =>
          `<h2><a href="${url}" rel="noopener noreferrer">${title}</a> <span class="score-badge" data-tier="${scoreTier(Number(score))}">${score}/10</span></h2>`,
      )
      html = html.replace(
        /^(\d+)\. \[([^\]]+)\]\(#item-(\d+)\) ⭐️ (\d+(?:\.\d+)?)\/10/gm,
        (_m, num, title, id, score) =>
          `<div class="toc-item"><span class="toc-num">${num}.</span> <a href="#item-${id}">${title}</a> <span class="score-badge" data-tier="${scoreTier(Number(score))}">${score}/10</span></div>`,
      )
      html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>')
      html = html.replace(/^---$/gm, '<hr />')
      html = html.replace(/^&gt; (.+)$/gm, '<blockquote>$1</blockquote>')
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>')
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" rel="noopener noreferrer">$1</a>')
      html = html
        .split('\n\n')
        .map((block) => {
          const trimmed = block.trim()
          if (!trimmed) return ''
          if (/^<(h[12]|blockquote|hr|div|details|ul|ol)/.test(trimmed)) return trimmed
          if (/^<a id=/.test(trimmed)) return trimmed
          return `<p>${trimmed.replace(/\n/g, '<br />')}</p>`
        })
        .join('\n')
      return html
    }

    function showDigest(payload, badgeLabel) {
      const markdown = typeof payload === 'string' ? payload : payload.markdown
      const html =
        typeof payload === 'string'
          ? renderDigestMarkdown(payload)
          : payload.html || renderDigestMarkdown(payload.markdown || '')
      const empty = document.getElementById('digest-empty')
      const card = document.getElementById('digest-card')
      const article = document.getElementById('digest-article')
      if (empty) empty.classList.add('hidden')
      if (card) card.classList.remove('hidden')
      if (article) {
        article.innerHTML = html
      }
      const section = document.getElementById('digest-section')
      if (section) section.setAttribute('data-mode', 'personal')
      if (badgeLabel) setStatus(badgeLabel)
    }

    async function checkAuth() {
      try {
        const res = await fetch(`${apiUrl}/auth/me`, { credentials: 'include' })
        if (!res.ok) return
        const data = await res.json()
        if (!data.user) return
        ;['myDigestBtn', 'forceDigestBtn', 'fetchMoreBtn'].forEach((id) => {
          document.getElementById(id)?.classList.remove('hidden')
        })

        // Hydrate personal digest in-place (no reload)
        if (initialMode !== 'personal') {
          try {
            const dig = await fetch(`${apiUrl}/my-digest?peek=1`, { credentials: 'include' })
            if (dig.ok) {
              const body = await dig.json()
              if (body.markdown || body.html) {
                showDigest(body, 'Showing your personal digest (cached).')
              }
            }
          } catch {}
        }
      } catch {}
    }

    async function loadMyDigest(opts) {
      const force = !!opts?.force
      const limit = opts?.limit ?? 15
      setStatus(
        force
          ? `Rescoring up to ${limit} items…`
          : `Generating digest (up to ${limit} items)…`,
      )
      try {
        const q = new URLSearchParams({ fast: '1', limit: String(limit) })
        if (force) q.set('force', '1')
        const res = await fetch(`${apiUrl}/my-digest?${q}`, { credentials: 'include' })
        const data = await res.json()
        if (res.ok && (data.markdown || data.html)) {
          const c = data.itemCounts ?? {}
          showDigest(
            data,
            c.cached
              ? 'Loaded cached digest.'
              : `Done — ${c.scored ?? 0} items (limit ${c.limit ?? limit}).`,
          )
        } else {
          setStatus(
            data.error ??
              data.code ??
              'Generate failed. Ensure sources exist and GROQ_API_KEY is set.',
          )
        }
      } catch (e) {
        setStatus(`Error: ${e.message} (request may have timed out — try again)`)
      }
    }

    document.getElementById('triggerBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('triggerBtn')
      if (btn) btn.setAttribute('disabled', 'true')
      setStatus('Running global pipeline… this can take a few minutes')
      try {
        const res = await fetch(`${apiUrl}/trigger`, { method: 'POST' })
        const data = await res.json()
        if (data.ok) {
          setStatus(`Pipeline done — ${data.items} items. Click Generate or Fetch more.`)
        } else {
          setStatus(`Failed: ${data.error ?? 'unknown'}`)
        }
      } catch (e) {
        setStatus(`Error: ${e.message}`)
      }
      if (btn) btn.removeAttribute('disabled')
    })

    document.getElementById('myDigestBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('myDigestBtn')
      if (btn) btn.setAttribute('disabled', 'true')
      await loadMyDigest({ force: false, limit: 15 })
      if (btn) btn.removeAttribute('disabled')
    })

    document.getElementById('fetchMoreBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('fetchMoreBtn')
      if (btn) btn.setAttribute('disabled', 'true')
      // Score more items than default and re-render
      await loadMyDigest({ force: true, limit: 30 })
      if (btn) btn.removeAttribute('disabled')
    })

    document.getElementById('forceDigestBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('forceDigestBtn')
      if (btn) btn.setAttribute('disabled', 'true')
      await loadMyDigest({ force: true, limit: 15 })
      if (btn) btn.removeAttribute('disabled')
    })

    checkAuth()
  </script>
</AppShell>
