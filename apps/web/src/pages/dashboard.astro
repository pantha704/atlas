---
import Base from '../layouts/Base.astro'
---

<Base title="Dashboard — Atlas">
  <main class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-3xl font-bold text-text">Today's digest</h1>
    <p class="mt-2 text-text-muted">
      <a href="/signup">Sign up</a> to personalize your digest with connected sources and impact reasoning.
    </p>
    <div class="mt-12 rounded-lg border border-border bg-surface p-8 text-center text-text-muted">
      No digest yet. The pipeline runs on connect.
    </div>
  </main>
</Base>
