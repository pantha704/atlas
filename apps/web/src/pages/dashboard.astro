---
import { renderDigestMarkdown } from '@atlas/core'
import Base from '../layouts/Base.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'

// ponytail: server-side fetch for the public digest; client JS handles auth state + per-user
let digestMd: string | null = null
let digestError: string | null = null
try {
  const res = await fetch(`${API_URL}/digest`, { signal: AbortSignal.timeout(5000) })
  if (res.ok) {
    const data = (await res.json()) as { markdown?: string }
    digestMd = data.markdown ?? null
  } else {
    digestError = 'Pipeline has not run yet. Click "Trigger pipeline" or wait for the daily cron.'
  }
} catch {
  digestError = 'API not reachable. Run `bun dev` first.'
}

// Demo fallback when no live digest yet
let isDemo = false
if (!digestMd) {
  try {
    const res = await fetch(`${API_URL}/demo/digest`, { signal: AbortSignal.timeout(5000) })
    if (res.ok) {
      const data = (await res.json()) as { markdown?: string; demo?: boolean }
      if (data.markdown) {
        digestMd = data.markdown
        isDemo = true
        digestError = null
      }
    }
  } catch {
    // keep prior error
  }
}
---

<Base title="Dashboard — Atlas">
  <main class="mx-auto max-w-4xl px-6 py-12">
    <!-- Auth-aware header -->
    <div id="auth-header" class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-text">Today's digest</h1>
        <p id="digest-subtitle" class="mt-2 text-text-muted">
          {isDemo
            ? 'Demo preview (seed data). Sign up to personalize.'
            : 'Public global digest.'}{' '}
          <a href="/signup" class="text-primary">Sign up</a> to personalize.
        </p>
      </div>
      <div id="auth-actions" class="flex gap-3">
        <a href="/signup" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover">Sign up</a>
      </div>
    </div>

    <!-- Trigger + regenerate buttons -->
    <div class="mt-4 flex gap-3 flex-wrap">
      <button id="triggerBtn" class="rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:border-primary">
        ↻ Trigger global pipeline
      </button>
      <button id="myDigestBtn" class="hidden rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:border-primary">
        ↻ Generate my personalized digest
      </button>
      <button id="forceDigestBtn" class="hidden rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:border-primary">
        Force rescore
      </button>
      <p id="triggerStatus" class="self-center text-sm text-text-muted"></p>
    </div>

    <!-- Digest content -->
    <div id="digestContainer" class="mt-12">
      {digestError && (
        <div class="rounded-lg border border-border bg-surface-2 p-8 text-center text-text-muted">
          {digestError}
        </div>
      )}
      {digestMd && (
        <div class="prose-atlas" set:html={renderDigestMarkdown(digestMd)}></div>
      )}
    </div>
  </main>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    // Auth state check
    async function checkAuth() {
      try {
        const res = await fetch(`${apiUrl}/auth/me`, { credentials: 'include' })
        if (res.ok) {
          const data = await res.json()
          if (data.user) {
            // Logged in — show personalized UI
            const subtitle = document.getElementById('digest-subtitle')
            const actions = document.getElementById('auth-actions')
            const myDigestBtn = document.getElementById('myDigestBtn')
            if (subtitle) subtitle.innerHTML = `Welcome back, <strong>${data.user.name}</strong>. <a href="/profile" class="text-primary">Edit profile</a> · <a href="/sources" class="text-primary">Manage sources</a>`
            if (actions) actions.innerHTML = `<a href="/profile" class="rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:border-primary">Profile</a><button onclick="logout()" class="rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text hover:border-primary">Logout</button>`
            if (myDigestBtn) myDigestBtn.classList.remove('hidden')
            const forceBtn = document.getElementById('forceDigestBtn')
            if (forceBtn) forceBtn.classList.remove('hidden')
            // Load cached same-day digest if available
            loadMyDigest(false)
          }
        }
      } catch {}
    }

    async function loadMyDigest(force) {
      const status = document.getElementById('triggerStatus')
      if (status) status.textContent = force ? 'Rescoring…' : 'Loading your digest…'
      try {
        const url = force ? `${apiUrl}/my-digest?force=1` : `${apiUrl}/my-digest`
        const res = await fetch(url, { credentials: 'include' })
        const data = await res.json()
        if (res.ok && data.markdown) {
          const container = document.getElementById('digestContainer')
          if (container) {
            // Server already rendered public/demo; client replaces with personal markdown as text
            // Full HTML render requires reload after save — force reload for consistency
            if (status) {
              const c = data.itemCounts ?? {}
              status.textContent = data.itemCounts?.cached
                ? 'Loaded cached digest for today.'
                : `Done — ${c.scored ?? 0} items (${c.fromCache ?? 0} cached scores, ${c.newlyScored ?? 0} new).`
            }
            if (force || !data.itemCounts?.cached) {
              setTimeout(() => location.reload(), 800)
            }
          }
        } else if (status) {
          status.textContent = data.error ?? 'No personal digest yet — click Generate.'
        }
      } catch (e) {
        if (status) status.textContent = `Error: ${e.message}`
      }
    }

    async function logout() {
      await fetch(`${apiUrl}/auth/logout`, { method: 'POST', credentials: 'include' })
      location.reload()
    }
    window.logout = logout

    // Global pipeline trigger
    document.getElementById('triggerBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('triggerBtn')
      const status = document.getElementById('triggerStatus')
      btn.disabled = true
      status.textContent = 'Running global pipeline... ~2-5 min'
      try {
        const res = await fetch(`${apiUrl}/trigger`, { method: 'POST' })
        const data = await res.json()
        if (data.ok) {
          status.textContent = `Done — ${data.items} items. Refreshing...`
          setTimeout(() => location.reload(), 2000)
        } else {
          status.textContent = `Failed: ${data.error ?? 'unknown'}`
          btn.disabled = false
        }
      } catch (e) {
        status.textContent = `Error: ${e.message}`
        btn.disabled = false
      }
    })

    // Per-user digest trigger
    document.getElementById('myDigestBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('myDigestBtn')
      if (btn) btn.disabled = true
      await loadMyDigest(false)
      if (btn) btn.disabled = false
    })
    document.getElementById('forceDigestBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('forceDigestBtn')
      if (btn) btn.disabled = true
      await loadMyDigest(true)
      if (btn) btn.disabled = false
    })

    checkAuth()
  </script>
</Base>
