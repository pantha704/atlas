---
import Base from '../layouts/Base.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<Base title="Item — Atlas">
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a href="/dashboard" class="text-sm text-text-muted hover:text-text">← Back to dashboard</a>
    <div id="item-content" class="mt-8">
      <p class="text-text-muted">Loading item...</p>
    </div>
  </main>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    async function loadItem() {
      const params = new URLSearchParams(location.search)
      const id = params.get('id')
      if (!id) {
        document.getElementById('item-content').innerHTML = '<p class="text-text-muted">No item ID specified.</p>'
        return
      }
      try {
        const res = await fetch(`${apiUrl}/items/${encodeURIComponent(id)}`, { credentials: 'include' })
        if (res.status === 401) {
          document.getElementById('item-content').innerHTML = '<p class="text-text-muted">Please <a href="/signup" class="text-primary">sign in</a> to view this item.</p>'
          return
        }
        if (!res.ok) {
          const data = await res.json().catch(() => ({}))
          document.getElementById('item-content').innerHTML = `<p class="text-text-muted">${data.error ?? 'Item not found'}</p>`
          return
        }
        const data = await res.json()
        render(data)
      } catch (e) {
        document.getElementById('item-content').innerHTML = `<p class="text-text-muted">Failed to load: ${e.message}</p>`
      }
    }

    function tier(score) {
      if (score >= 9) return 'high'
      if (score >= 7) return 'good'
      if (score >= 5) return 'mid'
      return 'low'
    }

    function render(data) {
      const { item, score } = data
      let html = `
        <h1 class="text-3xl font-bold text-text">
          <a href="${item.url}" class="hover:text-primary" target="_blank" rel="noopener">${esc(item.title)}</a>
        </h1>
        <div class="mt-2 text-sm text-text-muted">
          ${item.author ? `by ${esc(item.author)} · ` : ''}${new Date(item.publishedAt).toLocaleDateString()}
        </div>
      `
      if (score) {
        html += `
          <div class="mt-6 rounded-lg border border-border bg-surface p-6">
            <div class="flex items-center gap-3">
              <span class="score-badge" data-tier="${tier(score.value)}">${score.value}/10</span>
              <span class="text-sm text-text-muted">Your score</span>
            </div>
            <p class="mt-3 text-text">${esc(score.reason)}</p>
            ${score.tags.length ? `<div class="mt-3 flex flex-wrap gap-2">${score.tags.map(t => `<code class="text-xs bg-surface-2 px-2 py-0.5 rounded">${esc(t)}</code>`).join('')}</div>` : ''}
          </div>
        `
        if (score.impact) {
          const imp = score.impact
          const affects = imp.affectsStack
          const confColor = imp.confidence === 'high' ? 'text-emerald-500' : imp.confidence === 'medium' ? 'text-amber-500' : 'text-slate-400'
          html += `
            <div class="mt-4 rounded-lg border border-border bg-surface p-6">
              <h2 class="text-lg font-semibold text-text">Impact on your stack</h2>
              <div class="mt-4 space-y-3">
                <div class="flex gap-4">
                  <span class="w-40 text-sm text-text-muted">Affects your stack?</span>
                  <span class="font-medium ${affects ? 'text-emerald-500' : 'text-slate-400'}">${affects ? 'Yes' : 'No'}</span>
                </div>
                ${imp.affectedComponents.length ? `
                  <div class="flex gap-4">
                    <span class="w-40 text-sm text-text-muted">Affected components</span>
                    <span class="flex flex-wrap gap-2">${imp.affectedComponents.map(c => `<code class="text-xs bg-surface-2 px-2 py-0.5 rounded">${esc(c)}</code>`).join('')}</span>
                  </div>
                ` : ''}
                <div class="flex gap-4">
                  <span class="w-40 text-sm text-text-muted">Action</span>
                  <span class="text-text">${esc(imp.action)}</span>
                </div>
                <div class="flex gap-4">
                  <span class="w-40 text-sm text-text-muted">Confidence</span>
                  <span class="font-medium ${confColor}">${imp.confidence}</span>
                </div>
              </div>
            </div>
          `
        }
      }
      document.getElementById('item-content').innerHTML = html
    }

    function esc(s) {
      const d = document.createElement('div')
      d.textContent = s ?? ''
      return d.innerHTML
    }

    loadItem()
  </script>
</Base>
