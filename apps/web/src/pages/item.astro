---
import AppShell from '../layouts/AppShell.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<AppShell title="Item — Atlas" description="Scored item detail" width="md">
  <a href="/dashboard" class="text-sm text-text-muted no-underline hover:text-text">← Back to digest</a>
  <div id="item-content" class="mt-6" aria-live="polite">
    <div class="atlas-skeleton h-10 w-3/4 max-w-md" aria-hidden="true"></div>
    <div class="atlas-skeleton mt-4 h-32 w-full" aria-hidden="true"></div>
    <p class="sr-only">Loading item…</p>
  </div>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    let currentItemId = null

    async function loadItem() {
      const params = new URLSearchParams(location.search)
      const id = params.get('id')
      const el = document.getElementById('item-content')
      if (!id) {
        el.innerHTML = '<div class="atlas-banner" data-tone="warn">No item ID specified.</div>'
        return
      }
      try {
        const res = await fetch(`${apiUrl}/items/${encodeURIComponent(id)}`, { credentials: 'include' })
        if (res.status === 401) {
          el.innerHTML = `<div class="atlas-banner" data-tone="info">Please <a href="/signup" class="text-primary">sign in</a> to view scored items.</div>`
          return
        }
        if (!res.ok) {
          const data = await res.json().catch(() => ({}))
          el.innerHTML = `<div class="atlas-banner" data-tone="warn">${esc(data.error ?? 'Item not found')}</div>`
          return
        }
        const data = await res.json()
        currentItemId = data.item?.itemId ?? null
        render(data)
      } catch (e) {
        el.innerHTML = `<div class="atlas-banner" data-tone="warn">Failed to load: ${esc(e.message)}</div>`
      }
    }

    function tier(score) {
      if (score >= 9) return 'high'
      if (score >= 7) return 'good'
      if (score >= 5) return 'mid'
      return 'low'
    }

    function render(data) {
      const { item, score } = data
      let html = `
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h1 class="text-2xl font-medium tracking-tight text-text sm:text-3xl">
              <a href="${esc(item.url)}" class="text-text no-underline hover:text-primary" target="_blank" rel="noopener noreferrer">${esc(item.title)}</a>
            </h1>
            <p class="mt-2 text-sm text-text-muted">
              ${item.author ? `by ${esc(item.author)} · ` : ''}
              ${item.publishedAt ? new Date(item.publishedAt).toLocaleDateString() : ''}
            </p>
          </div>
          <a href="${esc(item.url)}" target="_blank" rel="noopener noreferrer"
            class="inline-flex h-9 shrink-0 items-center rounded-md border border-border bg-surface px-3 text-sm font-medium text-text no-underline hover:border-primary/50">
            Open source ↗
          </a>
        </div>
      `

      if (score) {
        html += `
          <div class="atlas-card mt-6 p-5">
            <div class="flex items-center gap-3">
              <span class="score-badge" data-tier="${tier(score.value)}">${score.value}/10</span>
              <span class="text-sm text-text-muted">Your score</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-text">${esc(score.reason)}</p>
            ${
              score.tags?.length
                ? `<div class="mt-3 flex flex-wrap gap-1.5">${score.tags
                    .map(
                      (t) =>
                        `<code class="rounded-md border border-border bg-surface-2 px-2 py-0.5 text-xs">${esc(t)}</code>`,
                    )
                    .join('')}</div>`
                : ''
            }
          </div>
        `

        if (score.impact) {
          const imp = score.impact
          const affects = imp.affectsStack ?? imp.affects_stack
          const components = imp.affectedComponents ?? imp.affected_components ?? []
          const conf = imp.confidence ?? 'low'
          const confClass =
            conf === 'high'
              ? 'text-[var(--color-score-high)]'
              : conf === 'medium'
                ? 'text-[var(--color-score-mid)]'
                : 'text-text-muted'
          html += `
            <div class="atlas-card mt-4 p-5">
              <h2 class="text-base font-medium text-text">Impact on your stack</h2>
              <dl class="mt-4 space-y-3 text-sm">
                <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                  <dt class="w-40 shrink-0 text-text-muted">Affects your stack?</dt>
                  <dd class="font-medium ${affects ? 'text-[var(--color-score-high)]' : 'text-text-muted'}">${affects ? 'Yes' : 'No'}</dd>
                </div>
                ${
                  components.length
                    ? `<div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                  <dt class="w-40 shrink-0 text-text-muted">Components</dt>
                  <dd class="flex flex-wrap gap-1.5">${components
                    .map(
                      (c) =>
                        `<code class="rounded-md border border-border bg-surface-2 px-2 py-0.5 text-xs">${esc(c)}</code>`,
                    )
                    .join('')}</dd>
                </div>`
                    : ''
                }
                <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                  <dt class="w-40 shrink-0 text-text-muted">Action</dt>
                  <dd class="text-text">${esc(imp.action ?? '')}</dd>
                </div>
                <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                  <dt class="w-40 shrink-0 text-text-muted">Confidence</dt>
                  <dd class="font-medium ${confClass}">${esc(conf)}</dd>
                </div>
              </dl>
            </div>
          `
        }
      } else {
        html += `<div class="atlas-banner mt-6" data-tone="info">No personal score yet. Generate your digest first.</div>`
      }

      // Feedback
      html += `
        <div class="atlas-card mt-6 p-5">
          <h2 class="text-base font-medium text-text">Teach Atlas</h2>
          <p class="mt-1 text-sm text-text-muted">Feedback adjusts your topic weights for future scoring.</p>
          <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Feedback">
            <button type="button" data-signal="up" class="fb-btn h-9 rounded-md border border-border bg-surface px-3 text-sm font-medium text-text hover:border-primary/50">👍 Useful</button>
            <button type="button" data-signal="down" class="fb-btn h-9 rounded-md border border-border bg-surface px-3 text-sm font-medium text-text hover:border-primary/50">👎 Not for me</button>
            <button type="button" data-signal="bookmark" class="fb-btn h-9 rounded-md border border-border bg-surface px-3 text-sm font-medium text-text hover:border-primary/50">🔖 Save</button>
            <button type="button" data-signal="dismiss" class="fb-btn h-9 rounded-md border border-border bg-surface px-3 text-sm font-medium text-text-muted hover:border-rose-500/40 hover:text-rose-500">Dismiss</button>
          </div>
          <p id="fb-status" class="mt-3 text-xs text-text-muted" aria-live="polite"></p>
        </div>
      `

      document.getElementById('item-content').innerHTML = html
      document.querySelectorAll('.fb-btn').forEach((btn) => {
        btn.addEventListener('click', () => sendFeedback(btn.getAttribute('data-signal'), btn))
      })
    }

    async function sendFeedback(signal, btn) {
      const status = document.getElementById('fb-status')
      if (!currentItemId) {
        if (status) status.textContent = 'Cannot send feedback — missing item id.'
        return
      }
      if (btn) btn.setAttribute('disabled', 'true')
      if (status) status.textContent = 'Saving…'
      try {
        const res = await fetch(`${apiUrl}/feedback`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ itemId: currentItemId, signal }),
        })
        const data = await res.json().catch(() => ({}))
        if (!res.ok) throw new Error(data.error ?? 'Failed')
        if (status) status.textContent = 'Saved — Atlas will weight similar items accordingly.'
      } catch (e) {
        if (status) status.textContent = `Error: ${e.message}`
      } finally {
        if (btn) btn.removeAttribute('disabled')
      }
    }

    function esc(s) {
      const d = document.createElement('div')
      d.textContent = s ?? ''
      return d.innerHTML
    }

    loadItem()
  </script>
</AppShell>
