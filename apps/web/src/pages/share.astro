---
import Base from '../layouts/Base.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? 'http://localhost:8787'
---

<Base title="Shared Digest — Atlas">
  <main class="mx-auto max-w-3xl px-6 py-12">
    <div id="share-content">
      <p class="text-text-muted">Loading shared digest...</p>
    </div>
  </main>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    async function loadShare() {
      const params = new URLSearchParams(location.search)
      const slug = params.get('id') ?? location.pathname.split('/share/')[1]
      if (!slug) {
        document.getElementById('share-content').innerHTML = '<p class="text-text-muted">No share ID.</p>'
        return
      }
      try {
        const res = await fetch(`${apiUrl}/share/${slug}`)
        if (!res.ok) {
          document.getElementById('share-content').innerHTML = '<p class="text-text-muted">Share not found.</p>'
          return
        }
        const data = await res.json()
        if (!data.digest) {
          document.getElementById('share-content').innerHTML = '<p class="text-text-muted">Digest not available.</p>'
          return
        }
        document.getElementById('share-content').innerHTML = `
          <h1 class="text-3xl font-bold text-text">Atlas Daily — ${data.digest.date}</h1>
          <p class="mt-2 text-sm text-text-muted">Shared digest · <a href="/signup" class="text-primary">Get your own personalized version</a></p>
          <div class="mt-8 prose-atlas">${renderMd(data.digest.markdown)}</div>
          <div class="mt-12 rounded-lg border border-border bg-surface p-6 text-center">
            <p class="text-text font-semibold">Powered by Atlas</p>
            <p class="mt-2 text-sm text-text-muted">Your personal news agent. Free. Open source.</p>
            <a href="/signup" class="mt-4 inline-block rounded-lg bg-primary px-6 py-2 text-sm font-semibold text-white hover:bg-primary-hover">Get started</a>
          </div>
        `
      } catch (e) {
        document.getElementById('share-content').innerHTML = `<p class="text-text-muted">Error: ${e.message}</p>`
      }
    }

    function renderMd(md) {
      let html = md.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>')
      html = html.replace(/^## \[([^\]]+)\]\(([^)]+)\) ⭐️ (\d+(?:\.\d+)?)\/10/gm, '<h2><a href="$2">$1</a> <span class="score-badge" data-tier="$3 >= 9 ? \'high\' : $3 >= 7 ? \'good\' : $3 >= 5 ? \'mid\' : \'low\'">$3/10</span></h2>')
      html = html.replace(/^---$/gm, '<hr />')
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>')
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
      html = html.split('\n\n').map(b => b.trim() ? `<p>${b.replace(/\n/g, '<br />')}</p>` : '').join('\n')
      return html
    }

    loadShare()
  </script>
</Base>
