---
import AppShell from '../layouts/AppShell.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<AppShell title="Shared Digest — Atlas" description="Shared Atlas digest" width="md">
  <div id="share-content" aria-live="polite">
    <div class="atlas-skeleton h-8 w-64" aria-hidden="true"></div>
    <div class="atlas-skeleton mt-6 h-48 w-full" aria-hidden="true"></div>
    <p class="sr-only">Loading shared digest…</p>
  </div>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    async function loadShare() {
      const el = document.getElementById('share-content')
      const params = new URLSearchParams(location.search)
      const slug = params.get('id') ?? location.pathname.split('/share/')[1]
      if (!slug) {
        el.innerHTML = '<div class="atlas-banner" data-tone="warn">No share ID.</div>'
        return
      }
      try {
        const res = await fetch(`${apiUrl}/share/${slug}`)
        if (!res.ok) {
          el.innerHTML = '<div class="atlas-banner" data-tone="warn">Share not found.</div>'
          return
        }
        const data = await res.json()
        if (!data.digest) {
          el.innerHTML = '<div class="atlas-banner" data-tone="info">Digest not available.</div>'
          return
        }
        el.innerHTML = `
          <h1 class="text-2xl font-medium tracking-tight text-text sm:text-3xl">Atlas Daily — ${esc(data.digest.date)}</h1>
          <p class="mt-2 text-sm text-text-muted">Shared digest · <a href="/signup" class="text-primary">Get your personalized version</a></p>
          <div class="atlas-card mt-8 overflow-hidden p-6 sm:p-8">
            <article class="prose-atlas max-w-none">${renderMd(data.digest.markdown)}</article>
          </div>
          <div class="atlas-card mt-10 p-6 text-center">
            <p class="text-sm font-medium text-text">Powered by Atlas</p>
            <p class="mt-1 text-sm text-text-muted">Your personal news agent. Free. Open source.</p>
            <a href="/signup" class="mt-4 inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-white no-underline hover:bg-primary-hover">Get started</a>
          </div>
        `
      } catch (e) {
        el.innerHTML = `<div class="atlas-banner" data-tone="warn">Error: ${esc(e.message)}</div>`
      }
    }

    function renderMd(md) {
      let html = String(md ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
      html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>')
      html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>')
      html = html.replace(/^---$/gm, '<hr />')
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>')
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
      // paragraphs: leave block tags alone
      return html
        .split(/\n\n+/)
        .map((b) => {
          const t = b.trim()
          if (!t) return ''
          if (/^<(h[12]|hr)/.test(t)) return t
          return `<p>${t.replace(/\n/g, '<br />')}</p>`
        })
        .join('\n')
    }

    function esc(s) {
      const d = document.createElement('div')
      d.textContent = s ?? ''
      return d.innerHTML
    }

    loadShare()
  </script>
</AppShell>
