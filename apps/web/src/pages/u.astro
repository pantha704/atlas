---
import AppShell from '../layouts/AppShell.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<AppShell title="User — Atlas" description="Public contributor profile">
  <div id="profile-content" aria-live="polite">
    <div class="atlas-skeleton h-10 w-48" aria-hidden="true"></div>
    <div class="atlas-skeleton mt-6 h-28 w-full" aria-hidden="true"></div>
    <p class="sr-only">Loading profile…</p>
  </div>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    async function loadProfile() {
      const el = document.getElementById('profile-content')
      const params = new URLSearchParams(location.search)
      const username = params.get('id') ?? params.get('username')
      if (!username) {
        el.innerHTML = '<div class="atlas-banner" data-tone="warn">No username specified.</div>'
        return
      }
      try {
        const res = await fetch(`${apiUrl}/market?limit=100`)
        const data = await res.json()
        const contributions = (data.sources ?? []).filter(
          (s) => s.contributorId === username || (s.name || '').toLowerCase().includes(username.toLowerCase()),
        )
        el.innerHTML = `
          <h1 class="text-2xl font-medium tracking-tight text-text sm:text-3xl">@${esc(username)}</h1>
          <p class="mt-2 text-sm text-text-muted">${contributions.length} contributed source${contributions.length !== 1 ? 's' : ''}</p>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            ${
              contributions.length
                ? contributions
                    .map(
                      (s) => `
              <a href="/market/source?id=${s.id}" class="atlas-card block p-4 no-underline transition-colors hover:border-primary/40">
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-md border border-border bg-surface-2 text-text-muted">${esc(s.type)}</span>
                <h3 class="mt-2 text-sm font-medium text-text">${esc(s.name)}</h3>
                <div class="mt-2 flex gap-4 text-xs text-text-muted">
                  <span>${s.userCount} users</span>
                  <span>${s.avgScore}/10 avg</span>
                </div>
              </a>`,
                    )
                    .join('')
                : '<p class="text-sm text-text-muted col-span-2">No contributions yet.</p>'
            }
          </div>
        `
      } catch (e) {
        el.innerHTML = `<div class="atlas-banner" data-tone="warn">Error: ${esc(e.message)}</div>`
      }
    }

    function esc(s) {
      const d = document.createElement('div')
      d.textContent = s ?? ''
      return d.innerHTML
    }

    loadProfile()
  </script>
</AppShell>
