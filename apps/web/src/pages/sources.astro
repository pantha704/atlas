---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import AppShell from '../layouts/AppShell.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<AppShell title="Sources — Atlas" description="Manage where Atlas fetches news" width="md">
  <PageHeader title="Your sources" description="Manage where Atlas fetches your daily news.">
    <Fragment slot="actions">
      <Button href="/onboarding" variant="secondary" size="sm">Guided setup</Button>
      <Button href="/market" variant="ghost" size="sm">Browse market</Button>
    </Fragment>
  </PageHeader>

    <div id="sources-list" class="mt-8 space-y-3">
      <div class="atlas-skeleton h-20 w-full" aria-hidden="true"></div>
      <div class="atlas-skeleton h-20 w-full" aria-hidden="true"></div>
      <p class="sr-only">Loading your sources…</p>
    </div>

    <!-- Add source form -->
    <Card class="mt-10">
      <h2 class="text-base font-medium text-text">Add a source</h2>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="add-type" class="block text-sm font-medium text-text">Type</label>
          <select id="add-type" class="mt-2 w-full rounded-lg border border-border bg-surface p-3 text-text focus:border-primary focus:outline-none">
            <option value="rss">RSS feed</option>
            <option value="github">GitHub repo releases</option>
            <option value="telegram">Telegram channel</option>
            <option value="hackernews">Hacker News</option>
            <option value="arxiv">arXiv category</option>
            <option value="reddit">Reddit subreddit</option>
            <option value="ossinsight">OSS Insight trending</option>
          </select>
        </div>
        <div id="config-fields">
          <label for="add-config" class="block text-sm font-medium text-text">URL / repo / channel</label>
          <input id="add-config" type="text" placeholder="https://example.com/feed.xml" class="mt-2 w-full rounded-lg border border-border bg-surface p-3 text-text placeholder:text-text-muted focus:border-primary focus:outline-none" />
        </div>
      </div>

      <Button id="add-source-btn" variant="primary" size="sm" class="mt-4">
        Add source
      </Button>
      <p id="add-status" class="mt-2 text-sm text-text-muted" aria-live="polite"></p>
    </Card>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    const typePlaceholders = {
      rss: 'https://example.com/feed.xml',
      github: 'owner/repo (e.g. openai/codex)',
      telegram: 'channel name (e.g. ai_china)',
      hackernews: 'auto-configured (leave empty)',
      arxiv: 'category (e.g. cs.AI)',
      reddit: 'subreddit (e.g. MachineLearning)',
      ossinsight: 'auto-configured (leave empty)',
    }

    const typeEl = document.getElementById('add-type')
    const configEl = document.getElementById('add-config')
    typeEl?.addEventListener('change', () => {
      if (configEl) configEl.placeholder = typePlaceholders[typeEl.value] ?? ''
    })

    async function loadSources() {
      try {
        const res = await fetch(`${apiUrl}/sources`, { credentials: 'include' })
        if (!res.ok) {
          if (res.status === 401) {
            location.href = '/signup'
            return
          }
          throw new Error('Failed to load')
        }
        const data = await res.json()
        renderSources(data.sources ?? [])
      } catch (e) {
        document.getElementById('sources-list').innerHTML = `<div class="atlas-banner" data-tone="warn">Error: ${e.message}</div>`
      }
    }

    function renderSources(sources) {
      const container = document.getElementById('sources-list')
      if (!sources.length) {
        container.innerHTML = `<div class="flex flex-col items-center rounded-lg border border-dashed border-border bg-surface-2/50 px-6 py-12 text-center">
          <p class="text-sm font-medium text-text">No sources yet</p>
          <p class="mt-1 text-sm text-text-muted">Add one below, use guided setup, or pick from the market.</p>
        </div>`
        return
      }
      container.innerHTML = sources.map(s => {
        const config = JSON.parse(s.config)
        const label = sourceLabel(s.type, config)
        return `<div class="flex flex-col gap-3 rounded-md border border-border bg-surface p-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 items-center gap-3">
            <span class="shrink-0 rounded-md border border-border bg-surface-2 px-2 py-1 text-[11px] font-mono text-text-muted">${s.type}</span>
            <div class="min-w-0">
              <div class="truncate text-sm font-medium text-text">${label}</div>
              <div class="text-xs text-text-muted">${s.enabled ? 'Enabled' : 'Disabled'}</div>
            </div>
          </div>
          <div class="flex shrink-0 gap-2">
            <button type="button" onclick="toggleSource('${s.id}', ${!s.enabled})" class="h-8 rounded-md border border-border px-3 text-xs font-medium text-text hover:border-primary/50">${s.enabled ? 'Disable' : 'Enable'}</button>
            <button type="button" onclick="deleteSource('${s.id}')" class="h-8 rounded-md border border-rose-500/25 px-3 text-xs font-medium text-rose-500 hover:bg-rose-500/10">Delete</button>
          </div>
        </div>`
      }).join('')
    }

    function sourceLabel(type, config) {
      switch (type) {
        case 'rss': return config.name || config.url
        case 'github': return `${config.owner}/${config.repo}`
        case 'telegram': return `@${config.channel || config.channels?.[0]?.channel}`
        case 'hackernews': return `HN (top ${config.fetchTopStories ?? 30}, min ${config.minScore ?? 100}pts)`
        case 'arxiv': return `arXiv: ${(config.categories ?? []).map(c => c.category).join(', ')}`
        case 'reddit': return (config.subreddits ?? []).map(s => `r/${s.subreddit}`).join(', ')
        case 'ossinsight': return `OSS Insight (${config.period ?? '24h'})`
        default: return 'Unknown'
      }
    }

    window.toggleSource = async (id, enabled) => {
      await fetch(`${apiUrl}/sources/${id}`, {
        method: 'PATCH',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled }),
      })
      loadSources()
    }

    window.deleteSource = async (id) => {
      if (!confirm('Delete this source?')) return
      await fetch(`${apiUrl}/sources/${id}`, {
        method: 'DELETE',
        credentials: 'include',
      })
      loadSources()
    }

    document.getElementById('add-source-btn')?.addEventListener('click', async () => {
      const type = typeEl?.value
      const configVal = configEl?.value?.trim()
      const status = document.getElementById('add-status')
      let config = {}

      switch (type) {
        case 'rss':
          if (!configVal) return alert('URL required')
          config = { name: configVal, url: configVal, enabled: true }
          break
        case 'github':
          if (!configVal?.includes('/')) return alert('owner/repo required')
          const [owner, repo] = configVal.split('/')
          config = { type: 'repo_releases', owner, repo, enabled: true }
          break
        case 'telegram':
          if (!configVal) return alert('channel required')
          config = { enabled: true, channels: [{ channel: configVal, enabled: true, fetchLimit: 20 }] }
          break
        case 'hackernews':
          config = { enabled: true, fetchTopStories: 30, minScore: 150 }
          break
        case 'arxiv':
          if (!configVal) return alert('category required')
          config = { enabled: true, categories: [{ category: configVal, enabled: true }], maxResults: 30 }
          break
        case 'reddit':
          if (!configVal) return alert('subreddit required')
          config = { enabled: true, subreddits: [{ subreddit: configVal, enabled: true, sort: 'hot', timeFilter: 'day', fetchLimit: 25, minScore: 10 }], users: [], fetchComments: 5 }
          break
        case 'ossinsight':
          config = { enabled: true, period: 'past_24_hours', languages: ['All'], keywords: [], minStars: 50, maxItems: 20 }
          break
      }

      try {
        status.textContent = 'Adding...'
        const res = await fetch(`${apiUrl}/sources`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, config, enabled: true }),
        })
        if (!res.ok) throw new Error('Failed')
        status.textContent = 'Added!'
        if (configEl) configEl.value = ''
        loadSources()
      } catch (e) {
        status.textContent = `Error: ${e.message}`
      }
    })

    loadSources()
  </script>
</AppShell>
