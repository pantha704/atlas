---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import AppShell from '../layouts/AppShell.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<AppShell title="Profile — Atlas" description="Your scoring profile and plan" width="md">
  <PageHeader
    title="Your profile"
    description="Atlas scores every item against this. Feedback makes it sharper."
  />

    <Card class="mt-8">
    <form id="profile-form" class="space-y-6">
      <div>
        <label for="interests" class="block text-sm font-medium text-text">What do you work on?</label>
        <textarea
          id="interests"
          rows="4"
          class="mt-2 w-full rounded-lg border border-border bg-surface p-3 text-text placeholder:text-text-muted focus:border-primary focus:outline-none"
          placeholder="e.g. I work on LLM training infrastructure, using PyTorch and CUDA. I care about efficient inference, quantization, and distributed training."
        ></textarea>
      </div>

      <div>
        <label for="stack" class="block text-sm font-medium text-text">Tech stack (comma-separated)</label>
        <input
          id="stack"
          type="text"
          class="mt-2 w-full rounded-lg border border-border bg-surface p-3 text-text placeholder:text-text-muted focus:border-primary focus:outline-none"
          placeholder="rust, python, pytorch, kubernetes"
        />
      </div>

      <div>
        <label for="language" class="block text-sm font-medium text-text">Digest language</label>
        <select id="language" class="mt-2 w-full rounded-lg border border-border bg-surface p-3 text-text focus:border-primary focus:outline-none">
          <option value="en">English</option>
          <option value="zh">中文</option>
        </select>
      </div>

      <div>
        <label for="threshold" class="block text-sm font-medium text-text">
          Score threshold: <span id="threshold-val" class="font-mono">7.0</span>
        </label>
        <input
          id="threshold"
          type="range"
          min="5"
          max="9"
          step="0.5"
          value="7"
          class="mt-2 w-full"
        />
        <p class="mt-1 text-xs text-text-muted">Higher = fewer items, more curated. Lower = more items, more noise.</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <Button type="submit" variant="primary" size="md">Save profile</Button>
        <span id="save-status" class="text-sm text-text-muted" aria-live="polite"></span>
      </div>
    </form>
    </Card>

    <!-- Plan + billing -->
    <Card class="mt-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-base font-medium text-text">Plan</h2>
          <p id="plan-label" class="mt-1 text-sm text-text-muted">Loading…</p>
        </div>
        <Button
          id="upgrade-btn"
          type="button"
          variant="primary"
          size="sm"
          class="hidden"
        >
          Upgrade to Pro — $8/mo
        </Button>
      </div>
      <p class="mt-3 text-xs text-text-muted">
        Free: 10 sources, web digest, top-3 impact. Pro: unlimited sources, email/RSS/webhook, top-10 impact.
      </p>
      <span id="billing-status" class="mt-2 block text-sm text-text-muted" aria-live="polite"></span>
    </Card>

    <!-- Delivery preferences — v0.4 (Pro for email/RSS/webhook) -->
    <Card class="mt-8">
      <h2 class="text-base font-medium text-text">Delivery</h2>
      <p class="mt-1 text-sm text-text-muted">
        Email, RSS, and webhooks are <strong class="text-text">Pro</strong>. Free plan: web dashboard only.
      </p>

      <div class="mt-4 space-y-4">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="pref-email" class="h-4 w-4 rounded border-border" />
          <label for="pref-email" class="text-sm text-text">Email digest daily</label>
        </div>
        <div class="flex items-center gap-3">
          <input type="checkbox" id="pref-rss" class="h-4 w-4 rounded border-border" />
          <label for="pref-rss" class="text-sm text-text">RSS feed (public, token-protected)</label>
        </div>
        <div id="rss-link-container" class="hidden ml-7">
          <code id="rss-link" class="text-xs text-text-muted break-all"></code>
        </div>
        <div>
          <label for="pref-webhook" class="block text-sm text-text">Webhook URL (optional)</label>
          <input
            id="pref-webhook"
            type="url"
            class="mt-2 w-full rounded-lg border border-border bg-surface p-3 text-text placeholder:text-text-muted focus:border-primary focus:outline-none"
            placeholder="https://hooks.slack.com/..."
          />
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Button id="save-delivery" type="button" variant="primary" size="sm">Save delivery</Button>
        <span id="delivery-status" class="text-sm text-text-muted" aria-live="polite"></span>
      </div>
    </Card>

    <!-- Tag weights (learned from feedback) -->
    <Card class="mt-8">
      <h2 class="text-base font-medium text-text">Topics you care about</h2>
      <p class="mt-1 text-sm text-text-muted">Learned from feedback. Upvote boosts; downvote reduces.</p>
      <div id="tag-weights" class="mt-4 flex flex-wrap gap-2">
        <span class="text-sm text-text-muted">No feedback yet. Rate items in your digest to teach Atlas.</span>
      </div>
    </Card>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    let currentPlan = 'free'

    async function loadPlan() {
      try {
        const res = await fetch(`${apiUrl}/auth/me`, { credentials: 'include' })
        if (!res.ok) return
        const data = await res.json()
        currentPlan = data.user?.plan ?? 'free'
        const label = document.getElementById('plan-label')
        const upgrade = document.getElementById('upgrade-btn')
        if (label) {
          label.innerHTML =
            currentPlan === 'pro'
              ? 'You are on <strong class="text-primary">Pro</strong>.'
              : 'You are on <strong>Free</strong>.'
        }
        if (upgrade) {
          if (currentPlan === 'free') upgrade.classList.remove('hidden')
          else upgrade.classList.add('hidden')
        }
      } catch {}
    }

    document.getElementById('upgrade-btn')?.addEventListener('click', async () => {
      const status = document.getElementById('billing-status')
      if (status) status.textContent = 'Opening Stripe Checkout…'
      try {
        const res = await fetch(`${apiUrl}/billing/checkout`, {
          method: 'POST',
          credentials: 'include',
        })
        const data = await res.json()
        if (res.status === 501) {
          if (status) status.textContent = 'Billing not configured yet (missing Stripe keys).'
          return
        }
        if (!res.ok || !data.url) throw new Error(data.error ?? 'Checkout failed')
        location.href = data.url
      } catch (e) {
        if (status) status.textContent = `Error: ${e.message}`
      }
    })

    async function loadProfile() {
      try {
        const res = await fetch(`${apiUrl}/profile`, { credentials: 'include' })
        if (!res.ok) {
          if (res.status === 401) { location.href = '/signup'; return }
          throw new Error('Failed')
        }
        const data = await res.json()
        const p = data.profile
        document.getElementById('interests').value = p.interests ?? ''
        document.getElementById('stack').value = (p.stack ?? []).join(', ')
        document.getElementById('language').value = p.language ?? 'en'
        document.getElementById('threshold').value = p.threshold ?? 7
        document.getElementById('threshold-val').textContent = p.threshold ?? '7.0'
        renderTagWeights(p.tagWeights ?? {})
      } catch (e) {
        document.getElementById('save-status').textContent = `Error: ${e.message}`
      }
    }

    function renderTagWeights(weights) {
      const container = document.getElementById('tag-weights')
      const entries = Object.entries(weights).sort((a, b) => b[1] - a[1])
      if (!entries.length) return
      container.innerHTML = entries.map(([tag, weight]) => {
        const size = Math.min(1 + weight * 0.2, 1.8)
        return `<span class="rounded-md bg-surface-2 px-3 py-1 text-sm" style="font-size:${size}rem">${tag} <span class="text-text-muted">(${weight})</span></span>`
      }).join('')
    }

    document.getElementById('threshold')?.addEventListener('input', (e) => {
      document.getElementById('threshold-val').textContent = e.target.value
    })

    document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const status = document.getElementById('save-status')
      status.textContent = 'Saving...'
      try {
        const res = await fetch(`${apiUrl}/profile`, {
          method: 'PUT',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            interests: document.getElementById('interests').value,
            stack: document.getElementById('stack').value.split(',').map(s => s.trim()).filter(Boolean),
            language: document.getElementById('language').value,
            threshold: parseFloat(document.getElementById('threshold').value),
          }),
        })
        if (!res.ok) throw new Error('Failed')
        status.textContent = 'Saved!'
      } catch (err) {
        status.textContent = `Error: ${err.message}`
      }
    })

    loadPlan()
    loadProfile()

    // v0.4: Delivery preferences
    let currentRssToken = null

    async function loadDelivery() {
      try {
        const res = await fetch(`${apiUrl}/profile`, { credentials: 'include' })
        if (!res.ok) return
        const data = await res.json()
        const prefs = data.profile.deliveryPrefs ?? {}
        currentRssToken = data.profile.rssToken ?? null
        document.getElementById('pref-email').checked = !!prefs.email
        document.getElementById('pref-rss').checked = !!prefs.rss
        document.getElementById('pref-webhook').value = prefs.webhookUrl ?? ''
        if (currentRssToken && prefs.rss) showRssLink(currentRssToken)
      } catch {}
    }

    function showRssLink(token) {
      const container = document.getElementById('rss-link-container')
      const link = document.getElementById('rss-link')
      if (container && link) {
        container.classList.remove('hidden')
        link.textContent = `${apiUrl}/rss/${token}.xml`
      }
    }

    document.getElementById('pref-rss')?.addEventListener('change', (e) => {
      if (e.target.checked && currentRssToken) showRssLink(currentRssToken)
      else document.getElementById('rss-link-container')?.classList.add('hidden')
    })

    document.getElementById('save-delivery')?.addEventListener('click', async () => {
      const status = document.getElementById('delivery-status')
      status.textContent = 'Saving...'
      try {
        const res = await fetch(`${apiUrl}/profile`, {
          method: 'PUT',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            deliveryPrefs: {
              email: document.getElementById('pref-email').checked,
              rss: document.getElementById('pref-rss').checked,
              webhookUrl: document.getElementById('pref-webhook').value || undefined,
            },
          }),
        })
        if (!res.ok) throw new Error('Failed')
        status.textContent = 'Saved!'
        if (document.getElementById('pref-rss').checked && currentRssToken) showRssLink(currentRssToken)
      } catch (err) {
        status.textContent = `Error: ${err.message}`
      }
    })

    loadDelivery()
  </script>
</AppShell>
