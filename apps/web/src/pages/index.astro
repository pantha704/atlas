---
import Base from '../layouts/Base.astro'
---

<Base title="Atlas — Your personal news agent">
  <!-- Hero -->
  <section class="mx-auto max-w-4xl px-6 pt-24 pb-16 text-center">
    <h1 class="text-5xl font-extrabold text-text leading-tight">
      Your personal news agent.<br />
      <span class="text-primary">Not a feed.</span>
    </h1>
    <p class="mt-6 text-lg text-text-muted max-w-2xl mx-auto">
      Connect your sources. Atlas scores every item against <em>your</em> profile, reasons about
      impact on <em>your</em> stack, and delivers daily. Free. Open source.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/signup"
        class="rounded-lg bg-primary px-8 py-3 text-base font-semibold text-white hover:bg-primary-hover"
        >Get started — GitHub OAuth</a
      >
      <a
        href="/market"
        class="rounded-lg border border-border bg-surface px-8 py-3 text-base font-medium text-text hover:border-primary"
        >Browse sources</a
      >
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="text-2xl font-bold text-text text-center">How it works</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      <div class="text-center">
        <div
          class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-lg"
        >
          1
        </div>
        <h3 class="font-semibold text-text">Connect sources</h3>
        <p class="mt-2 text-sm text-text-muted">
          HN, RSS, GitHub, arXiv, Reddit, Telegram, OSS Insight. Or browse the community market.
        </p>
      </div>
      <div class="text-center">
        <div
          class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-lg"
        >
          2
        </div>
        <h3 class="font-semibold text-text">Atlas scores daily</h3>
        <p class="mt-2 text-sm text-text-muted">
          AI scores every item 0-10 against your interests, stack, and feedback history. Threshold
          filters noise.
        </p>
      </div>
      <div class="text-center">
        <div
          class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-lg"
        >
          3
        </div>
        <h3 class="font-semibold text-text">Get impact reasoning</h3>
        <p class="mt-2 text-sm text-text-muted">
          For your top items: does this affect your stack? What should you do? Confidence level.
        </p>
      </div>
    </div>
  </section>

  <!-- Why Atlas -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-lg border border-border bg-surface p-8">
      <h2 class="text-2xl font-bold text-text">Why Atlas is different</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="font-semibold text-text">Your profile, your moat</h3>
          <p class="mt-2 text-sm text-text-muted">
            Every upvote/downvote refines your scoring. No competitor can replicate your taste
            graph.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-text">Network effect</h3>
          <p class="mt-2 text-sm text-text-muted">
            Every user's source additions flow into the public market. Aggregated independent
            judgments → collective quality signal.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-text">Free forever</h3>
          <p class="mt-2 text-sm text-text-muted">
            Built on free tiers: Vercel, Turso, Groq, Gemini. Self-host in 15 minutes.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-text">Open source</h3>
          <p class="mt-2 text-sm text-text-muted">
            AGPL-3.0. Full transparency. Contribute, improve, or fork and run your own.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-4xl px-6 py-16 text-center">
    <h2 class="text-3xl font-bold text-text">Stop scrolling. Start knowing.</h2>
    <p class="mt-4 text-text-muted">Atlas is free. Sign up in 30 seconds with GitHub.</p>
    <a
      href="/signup"
      class="mt-6 inline-block rounded-lg bg-primary px-8 py-3 text-base font-semibold text-white hover:bg-primary-hover"
      >Get started</a
    >
  </section>

  <!-- Footer -->
  <footer class="mx-auto max-w-4xl px-6 py-12 border-t border-border">
    <div class="flex flex-wrap justify-between gap-8 text-sm text-text-muted">
      <div><span class="font-bold text-text">Atlas</span> — Your personal news agent.</div>
      <div class="flex gap-6">
        <a href="/dashboard" class="hover:text-text">Dashboard</a>
        <a href="/market" class="hover:text-text">Market</a>
        <a href="/docs" class="hover:text-text">Docs</a>
        <a href="/legal/privacy" class="hover:text-text">Privacy</a>
      </div>
    </div>
  </footer>
</Base>
