---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import Badge from '../components/ui/Badge.astro'
import Base from '../layouts/Base.astro'
---

<Base title="Atlas — Your personal news agent">
  <!-- Marketing nav -->
  <header class="border-b border-border bg-bg/80 backdrop-blur-md sticky top-0 z-40">
    <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 text-text no-underline hover:text-text">
        <span
          class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-[11px] font-semibold text-white"
          aria-hidden="true"
        >
          A
        </span>
        <span class="text-sm font-medium tracking-tight">Atlas</span>
      </a>
      <nav class="flex items-center gap-1 sm:gap-2" aria-label="Marketing">
        <a href="/market" class="hidden rounded-md px-2.5 py-1.5 text-sm text-text-muted no-underline hover:text-text sm:inline"
          >Market</a
        >
        <a href="/docs" class="hidden rounded-md px-2.5 py-1.5 text-sm text-text-muted no-underline hover:text-text sm:inline"
          >Docs</a
        >
        <a href="/dashboard" class="rounded-md px-2.5 py-1.5 text-sm text-text-muted no-underline hover:text-text"
          >Digest</a
        >
        <Button href="/signup" variant="primary" size="sm">Sign in</Button>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <!-- Hero -->
    <section class="mx-auto max-w-5xl px-4 pb-16 pt-16 text-center sm:px-6 sm:pt-24">
      <Badge variant="primary" class="mb-6">Personal · not a crowd feed</Badge>
      <h1 class="mx-auto max-w-3xl text-4xl font-medium tracking-tight text-text sm:text-5xl sm:leading-[1.1]">
        Your personal news agent.<br />
        <span class="text-primary">Not a feed.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base text-text-muted sm:text-lg">
        Connect your sources. Atlas scores every item against <em class="text-text not-italic">your</em> profile,
        reasons about impact on <em class="text-text not-italic">your</em> stack, and delivers what matters —
        daily. Free forever. Open source.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="/signup" variant="primary" size="lg">Get started — GitHub</Button>
        <Button href="/dashboard" variant="secondary" size="lg">View demo digest</Button>
      </div>
      <p class="mt-4 text-xs text-text-muted">No card required · AGPL-3.0 · Self-host in minutes</p>
    </section>

    <!-- Product mock -->
    <section class="mx-auto max-w-5xl px-4 sm:px-6" aria-label="Product preview">
      <div
        class="overflow-hidden rounded-lg border border-border bg-surface shadow-[0_0_0_1px_var(--color-border-subtle)]"
      >
        <div class="flex items-center gap-2 border-b border-border bg-surface-2/50 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
          <span class="ml-2 text-xs text-text-muted">atlas.app / digest</span>
          <span class="ml-auto">
            <Badge variant="success">Personalized</Badge>
          </span>
        </div>
        <div class="grid gap-0 md:grid-cols-[1fr_1.2fr]">
          <div class="space-y-3 border-b border-border p-5 md:border-b-0 md:border-r">
            <p class="text-xs font-medium uppercase tracking-wider text-text-muted">Today · top for you</p>
            {
              [
                { score: 9.2, title: 'vLLM 0.8 ships continuous batching', tag: 'inference' },
                { score: 8.4, title: 'QLoRA memory paper — practical notes', tag: 'training' },
                { score: 7.8, title: 'Rust 1.85 async trait stab', tag: 'systems' },
              ].map((row) => (
                <div class="flex items-start gap-3 rounded-md border border-border bg-bg/40 p-3">
                  <span
                    class="score-badge shrink-0"
                    data-tier={row.score >= 9 ? 'high' : row.score >= 7 ? 'good' : 'mid'}
                  >
                    {row.score}
                  </span>
                  <div class="min-w-0 text-left">
                    <p class="truncate text-sm font-medium text-text">{row.title}</p>
                    <p class="mt-0.5 text-xs text-text-muted">#{row.tag}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="space-y-3 p-5 text-left">
            <p class="text-xs font-medium uppercase tracking-wider text-text-muted">Impact reasoning</p>
            <div class="rounded-md border border-primary/25 bg-primary/5 p-4">
              <p class="text-sm font-medium text-text">Affects your stack? Yes</p>
              <p class="mt-2 text-sm text-text-muted">
                Touches <code class="text-xs">vllm</code> and your inference path. Action: re-benchmark
                continuous batching on your A100s; expect 15–30% throughput lift on long contexts.
              </p>
              <p class="mt-3 text-xs text-text-muted">
                Confidence: <span class="font-medium text-[var(--color-score-high)]">high</span>
              </p>
            </div>
            <p class="text-xs text-text-muted">
              Free: top-3 impact · Pro: top-10 + email / RSS / webhook
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
      <h2 class="text-center text-2xl font-medium tracking-tight text-text">How it works</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          [
            {
              n: '1',
              t: 'Connect sources',
              d: 'HN, RSS, GitHub, arXiv, Reddit, Telegram, OSS Insight — or one-click from the market.',
            },
            {
              n: '2',
              t: 'Atlas scores daily',
              d: 'Every item is scored 0–10 against your interests, stack, and feedback. Threshold kills noise.',
            },
            {
              n: '3',
              t: 'Impact + action',
              d: 'Top items get stack impact: does it affect you, what to do, confidence level.',
            },
          ].map((s) => (
            <Card padding="md" class="text-left">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-sm font-medium text-primary">
                {s.n}
              </div>
              <h3 class="mt-4 text-base font-medium text-text">{s.t}</h3>
              <p class="mt-2 text-sm text-text-muted">{s.d}</p>
            </Card>
          ))
        }
      </div>
    </section>

    <!-- Why different -->
    <section class="mx-auto max-w-5xl px-4 pb-8 sm:px-6">
      <Card padding="lg">
        <h2 class="text-2xl font-medium tracking-tight text-text">Why Atlas is different</h2>
        <div class="mt-8 grid gap-8 sm:grid-cols-2">
          {
            [
              {
                t: 'Your profile is the moat',
                d: 'Upvotes and downvotes refine scoring. No competitor can copy your taste graph.',
              },
              {
                t: 'Network without a feed',
                d: 'Source adds flow into a public market. Independent judgments → collective quality.',
              },
              {
                t: 'Free forever core',
                d: 'Built on free tiers: Vercel, Turso, Groq, Gemini. Self-host when you want control.',
              },
              {
                t: 'Open source',
                d: 'AGPL-3.0. Full transparency. Contribute, improve, or fork and run your own.',
              },
            ].map((b) => (
              <div>
                <h3 class="text-sm font-medium text-text">{b.t}</h3>
                <p class="mt-2 text-sm text-text-muted">{b.d}</p>
              </div>
            ))
          }
        </div>
      </Card>
    </section>

    <!-- Pricing strip -->
    <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6" aria-labelledby="pricing-heading">
      <h2 id="pricing-heading" class="text-center text-2xl font-medium tracking-tight text-text">Simple pricing</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <Card padding="lg">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-medium text-text">Free</h3>
            <Badge variant="muted">Forever</Badge>
          </div>
          <p class="mt-2 text-3xl font-medium tracking-tight text-text">$0</p>
          <ul class="mt-6 space-y-2 text-sm text-text-muted">
            <li>10 sources</li>
            <li>Web digest</li>
            <li>Top-3 impact reasoning</li>
            <li>Score cache & personalization</li>
          </ul>
          <Button href="/signup" variant="secondary" size="md" class="mt-8 w-full">Start free</Button>
        </Card>
        <Card padding="lg" class="border-primary/40">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-medium text-text">Pro</h3>
            <Badge variant="pro">Recommended</Badge>
          </div>
          <p class="mt-2 text-3xl font-medium tracking-tight text-text">
            $8<span class="text-base font-normal text-text-muted">/mo</span>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-text-muted">
            <li>Unlimited sources</li>
            <li>Email, RSS, webhooks</li>
            <li>Top-10 impact reasoning</li>
            <li>Everything in Free</li>
          </ul>
          <Button href="/signup" variant="primary" size="md" class="mt-8 w-full">Upgrade after signup</Button>
        </Card>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mx-auto max-w-5xl px-4 pb-20 text-center sm:px-6">
      <h2 class="text-3xl font-medium tracking-tight text-text">Stop scrolling. Start knowing.</h2>
      <p class="mt-3 text-text-muted">Sign up in about 30 seconds with GitHub.</p>
      <Button href="/signup" variant="primary" size="lg" class="mt-6">Get started</Button>
    </section>
  </main>

  <footer class="border-t border-border">
    <div
      class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-text-muted sm:px-6"
    >
      <span><span class="font-medium text-text">Atlas</span> — your personal news agent</span>
      <div class="flex flex-wrap gap-5">
        <a href="/dashboard" class="text-text-muted no-underline hover:text-text">Digest</a>
        <a href="/market" class="text-text-muted no-underline hover:text-text">Market</a>
        <a href="/docs" class="text-text-muted no-underline hover:text-text">Docs</a>
        <a href="/legal/privacy" class="text-text-muted no-underline hover:text-text">Privacy</a>
        <a href="/legal/terms" class="text-text-muted no-underline hover:text-text">Terms</a>
      </div>
    </div>
  </footer>
</Base>
