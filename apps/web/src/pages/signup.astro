---
import Card from '../components/ui/Card.astro'
import Base from '../layouts/Base.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<Base title="Sign up — Atlas">
  <header class="border-b border-border">
    <div class="mx-auto flex h-14 max-w-md items-center px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 text-text no-underline hover:text-text">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-[11px] font-semibold text-white" aria-hidden="true">A</span>
        <span class="text-sm font-medium">Atlas</span>
      </a>
    </div>
  </header>

  <main id="main-content" class="mx-auto max-w-md px-4 py-16 sm:px-6">
    <h1 class="text-2xl font-medium tracking-tight text-text sm:text-3xl">Get started</h1>
    <p class="mt-3 text-sm text-text-muted sm:text-base">
      Your personal news agent. Connect sources — GitHub, arXiv, RSS, HN — and get what matters to
      <em class="not-italic font-medium text-text">your</em> work every day.
    </p>

    <Card class="mt-8" padding="lg">
      <a
        href={`${API_URL}/auth/github`}
        class="flex h-11 w-full items-center justify-center gap-3 rounded-md bg-text px-6 text-sm font-medium text-bg no-underline transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        Continue with GitHub
      </a>
      <p class="mt-4 text-center text-xs text-text-muted">
        Already have an account? Same button — we&apos;ll sign you in.
      </p>
    </Card>

    <p class="mt-8 text-center text-xs text-text-muted">
      By continuing you agree to our
      <a href="/legal/privacy" class="text-primary">Privacy Policy</a>
      and
      <a href="/legal/terms" class="text-primary">Terms</a>.
      Atlas is AGPL-3.0 open source.
    </p>
  </main>

  <script is:inline>
    const params = new URLSearchParams(location.search)
    const ref = params.get('ref')
    if (ref) {
      document.cookie = `atlas_ref=${ref}; Path=/; Max-Age=604800; SameSite=Lax`
    }
  </script>
</Base>
