---
import Button from '../components/ui/Button.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import AppShell from '../layouts/AppShell.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://atlas-nine-ashy.vercel.app'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Atlas Source Market',
  description: 'Community-curated news sources for your personal Atlas digest.',
  url: `${site}/market`,
  isPartOf: { '@type': 'WebSite', name: 'Atlas', url: site },
}
---

<AppShell
  title="Source Market — Atlas"
  description="Community-curated sources for your personal news agent"
  jsonLd={jsonLd}
  canonical={`${site}/market`}
>
  <PageHeader
    title="Source market"
    description="Community-curated sources. Add them to your Atlas in one click."
  >
    <Fragment slot="actions">
      <Button href="/market/submit" variant="primary" size="sm">Submit source</Button>
    </Fragment>
  </PageHeader>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <select id="filter-type" class="rounded-md border border-border bg-surface px-3 py-2 text-sm text-text">
        <option value="">All types</option>
        <option value="hackernews">Hacker News</option>
        <option value="rss">RSS</option>
        <option value="github">GitHub</option>
        <option value="arxiv">arXiv</option>
        <option value="reddit">Reddit</option>
        <option value="telegram">Telegram</option>
        <option value="ossinsight">OSS Insight</option>
      </select>
      <select id="sort-by" class="rounded-md border border-border bg-surface px-3 py-2 text-sm text-text">
        <option value="latest">Latest</option>
        <option value="users">Most users</option>
        <option value="quality">Highest quality</option>
        <option value="snr">Best signal</option>
      </select>
      <input id="search" type="search" placeholder="Search…" class="w-full flex-1 rounded-md border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-text-muted" />
    </div>

    <div id="market-grid" class="mt-8 grid gap-3 sm:grid-cols-2">
      <div class="atlas-skeleton h-28 col-span-2 sm:col-span-1" aria-hidden="true"></div>
      <div class="atlas-skeleton h-28 col-span-2 sm:col-span-1" aria-hidden="true"></div>
      <p class="sr-only">Loading sources…</p>
    </div>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    let allSources = []

    async function loadMarket() {
      try {
        const res = await fetch(`${apiUrl}/market?limit=100`)
        const data = await res.json()
        allSources = data.sources ?? []
        render()
      } catch (e) {
        document.getElementById('market-grid').innerHTML = `<p class="text-text-muted col-span-2">Failed to load: ${e.message}</p>`
      }
    }

    function render() {
      const type = document.getElementById('filter-type').value
      const sort = document.getElementById('sort-by').value
      const search = document.getElementById('search').value.toLowerCase()

      let filtered = allSources
      if (type) filtered = filtered.filter(s => s.type === type)
      if (search) filtered = filtered.filter(s => s.name.toLowerCase().includes(search) || (s.bio ?? '').toLowerCase().includes(search))

      if (sort === 'users') filtered.sort((a, b) => b.userCount - a.userCount)
      else if (sort === 'quality') filtered.sort((a, b) => b.avgScore - a.avgScore)
      else if (sort === 'snr') filtered.sort((a, b) => b.snr - a.snr)
      else filtered.sort((a, b) => (b.createdAt ?? '').localeCompare(a.createdAt ?? ''))

      const grid = document.getElementById('market-grid')
      if (!filtered.length) {
        grid.innerHTML = '<p class="text-text-muted col-span-2">No sources found.</p>'
        return
      }
      grid.innerHTML = filtered.map(s => `
        <a href="/market/source?id=${s.id}" class="atlas-card block p-4 no-underline transition-colors hover:border-primary/40">
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-md border border-border bg-surface-2 text-text-muted">${esc(s.type)}</span>
            ${s.fieldTags ? s.fieldTags.split(',').slice(0, 3).map(t => `<span class="text-[11px] px-2 py-0.5 rounded-full border border-primary/25 bg-primary/10 text-primary">${esc(t.trim())}</span>`).join('') : ''}
          </div>
          <h3 class="mt-2.5 text-base font-medium text-text">${esc(s.name)}</h3>
          ${s.bio ? `<p class="mt-1 text-sm text-text-muted line-clamp-2">${esc(s.bio)}</p>` : ''}
          <div class="mt-3 flex gap-4 text-xs text-text-muted">
            <span>${s.userCount} users</span>
            <span>${s.avgScore}/10 avg</span>
            <span>${Math.round(s.snr * 100)}% signal</span>
          </div>
        </a>
      `).join('')
    }

    function esc(s) {
      const d = document.createElement('div')
      d.textContent = s ?? ''
      return d.innerHTML
    }

    document.getElementById('filter-type')?.addEventListener('change', render)
    document.getElementById('sort-by')?.addEventListener('change', render)
    document.getElementById('search')?.addEventListener('input', render)

    loadMarket()
  </script>
</AppShell>
