---
import Base from '../layouts/Base.astro'

const API_URL = import.meta.env.PUBLIC_ATLAS_API_URL ?? '/api'
---

<Base title="Source Market — Atlas">
  <main class="mx-auto max-w-4xl px-6 py-12">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-text">Source market</h1>
        <p class="mt-2 text-text-muted">Community-curated sources. Add them to your Atlas in one click.</p>
      </div>
      <a href="/market/submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover">Submit source</a>
    </div>

    <div class="mt-8 flex gap-4">
      <select id="filter-type" class="rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text">
        <option value="">All types</option>
        <option value="hackernews">Hacker News</option>
        <option value="rss">RSS</option>
        <option value="github">GitHub</option>
        <option value="arxiv">arXiv</option>
        <option value="reddit">Reddit</option>
        <option value="telegram">Telegram</option>
        <option value="ossinsight">OSS Insight</option>
      </select>
      <select id="sort-by" class="rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text">
        <option value="latest">Latest</option>
        <option value="users">Most users</option>
        <option value="quality">Highest quality</option>
        <option value="snr">Best signal</option>
      </select>
      <input id="search" type="text" placeholder="Search..." class="flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text placeholder:text-text-muted focus:border-primary focus:outline-none" />
    </div>

    <div id="market-grid" class="mt-8 grid gap-4 sm:grid-cols-2">
      <p class="text-text-muted col-span-2">Loading sources...</p>
    </div>
  </main>

  <script is:inline define:vars={{ apiUrl: API_URL }}>
    let allSources = []

    async function loadMarket() {
      try {
        const res = await fetch(`${apiUrl}/market?limit=100`)
        const data = await res.json()
        allSources = data.sources ?? []
        render()
      } catch (e) {
        document.getElementById('market-grid').innerHTML = `<p class="text-text-muted col-span-2">Failed to load: ${e.message}</p>`
      }
    }

    function render() {
      const type = document.getElementById('filter-type').value
      const sort = document.getElementById('sort-by').value
      const search = document.getElementById('search').value.toLowerCase()

      let filtered = allSources
      if (type) filtered = filtered.filter(s => s.type === type)
      if (search) filtered = filtered.filter(s => s.name.toLowerCase().includes(search) || (s.bio ?? '').toLowerCase().includes(search))

      if (sort === 'users') filtered.sort((a, b) => b.userCount - a.userCount)
      else if (sort === 'quality') filtered.sort((a, b) => b.avgScore - a.avgScore)
      else if (sort === 'snr') filtered.sort((a, b) => b.snr - a.snr)
      else filtered.sort((a, b) => (b.createdAt ?? '').localeCompare(a.createdAt ?? ''))

      const grid = document.getElementById('market-grid')
      if (!filtered.length) {
        grid.innerHTML = '<p class="text-text-muted col-span-2">No sources found.</p>'
        return
      }
      grid.innerHTML = filtered.map(s => `
        <a href="/market/source?id=${s.id}" class="block rounded-lg border border-border bg-surface p-4 hover:border-primary transition-colors">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-2 text-text-muted">${esc(s.type)}</span>
            ${s.fieldTags ? s.fieldTags.split(',').slice(0, 3).map(t => `<span class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary">${esc(t.trim())}</span>`).join('') : ''}
          </div>
          <h3 class="mt-2 text-lg font-semibold text-text">${esc(s.name)}</h3>
          ${s.bio ? `<p class="mt-1 text-sm text-text-muted line-clamp-2">${esc(s.bio)}</p>` : ''}
          <div class="mt-3 flex gap-4 text-xs text-text-muted">
            <span>${s.userCount} users</span>
            <span>${s.avgScore}/10 avg</span>
            <span>${Math.round(s.snr * 100)}% signal</span>
          </div>
        </a>
      `).join('')
    }

    function esc(s) {
      const d = document.createElement('div')
      d.textContent = s ?? ''
      return d.innerHTML
    }

    document.getElementById('filter-type')?.addEventListener('change', render)
    document.getElementById('sort-by')?.addEventListener('change', render)
    document.getElementById('search')?.addEventListener('input', render)

    loadMarket()
  </script>
</Base>
