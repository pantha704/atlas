# Atlas — environment variables

# App URL (for OAuth callback)
APP_URL=https://atlas-api.glm-panther.workers.dev

# Turso (libSQL) — free tier: https://turso.tech
TURSO_DATABASE_URL=libsql://atlas-pantha704.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=

# AI — Groq free tier: https://console.groq.com
GROQ_API_KEY=

# AI fallback — Gemini free tier: https://aistudio.google.com
GEMINI_API_KEY=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=Ov23lig3t21oPhh2bCFd
GITHUB_CLIENT_SECRET=

# Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub token (optional — raises rate limits for GitHub scraper)
GITHUB_TOKEN=

# Email (Resend) — free tier 3k/mo: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Atlas <onboarding@resend.dev>

# Web search (Brave) — free tier 2k/mo: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Analytics (PostHog) — free tier 1M events/mo
# Server: signup, digest_ready, feedback, referral. No-op if empty.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Errors (Sentry) — free tier 5k errors/mo
# Server: app.onError + cron pipeline failures. No-op if empty.
SENTRY_DSN=

# Demo mode — seed digest without auth (pitch / empty state)
DEMO_MODE=false

# Vercel Cron / external scheduler — Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Razorpay billing (Pro monthly) — https://dashboard.razorpay.com
# Key ID + Secret required. Prefer a Subscription Plan id for recurring.
# Without PLAN_ID: payment link for ₹699 (69900 paise) → 30-day Pro.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_AMOUNT_PAISE=69900
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL: https://YOUR_DOMAIN/api/billing/webhook
# Enable: subscription.*, payment.captured, payment_link.paid
